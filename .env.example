# Cloudflare R2 Public CDN URL or Custom Domain
# Example (R2 dev url): https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
# Example (Custom domain): https://assets.kitchenbots.in
VITE_CDN_URL=

# Separate customer portal URL. Falls back to /login during local development.
VITE_PORTAL_URL=

# API Base URL (Cloudflare Worker API or dev backend)
VITE_API_URL=

# Firebase Client Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudflare R2 Upload Credentials (Only needed for scripts/upload-to-r2.mjs)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
