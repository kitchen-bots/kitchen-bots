{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "storefront": {
      "root": "apps/storefront"
    },
    "backend": {
      "root": "apps/backend"
    }
  },
  "rewrites": [
    {
      "source": "/admin",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/admin/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/_next/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "storefront"
      }
    }
  ]
}
